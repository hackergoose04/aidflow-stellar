# Copy nothing here by hand: scripts/testnet_setup.py writes .env for you.
# TESTNET ONLY. Never commit the real .env.
HORIZON_URL=https://horizon-testnet.stellar.org
RPC_URL=https://soroban-testnet.stellar.org
ASSET_CODE=AIDUSD
# Amount review threshold in ASSET_CODE units. Use 'off' to disable the rule.
# AMOUNT_LIMIT=500
# Enable policy changes on a trusted operator instance. Reviewer names are audit labels.
# SCREENING_POLICY_EDITING=on
# CHECK_BATCH_PAYOUT_SLOT=on
# BATCH_INSTALLMENT_SCHEDULE='{"BATCH-16":16}'
# BATCH_BENEFIT_MONTH_SCHEDULE='{"BATCH-OCT":"2026-10"}'
# AIDFLOW_MODEL_PATH=ml/models/isoforest.joblib
ISSUER_PUBLIC=
ISSUER_SECRET=
DISTRIBUTION_PUBLIC=
DISTRIBUTION_SECRET=
BEN1_PUBLIC=
BEN1_SECRET=
BEN2_PUBLIC=
BEN2_SECRET=
BEN3_PUBLIC=
BEN3_SECRET=
# Added by scripts/registry_deploy.py (on-chain registry, Plan B)
REGISTRY_CONTRACT_ID=
REGISTRY_SECRET=
PROGRAM_ID=AIDFLOW-DEMO
# Optional additional payout slots, e.g. base,medical_supplement. Each needs individual review.
PAYOUT_SLOTS=base
# HMAC key for beneficiary IDs (python -c "import secrets; print(secrets.token_hex(32))").
# Keep it: changing it makes every stored beneficiary token unmatchable.
PII_HMAC_SECRET=
# Last mile: flag claimable balances still unclaimed after this many hours.
CLAIM_ALERT_HOURS=72
# XLM price used only to show network fees in dollars (an assumption, not a live price).
XLM_USD=0.30
# Storage. Empty: local SQLite file (data/aidflow.db). Set: Postgres, e.g. a Neon pooled
# connection string (postgresql://user:password@host/db?sslmode=require). Never commit it.
DATABASE_URL=
